# AI API Configuration
# Choose one AI provider and fill in the corresponding fields.

# === Alibaba Cloud Qwen (Recommended) ===
# AI_API_KEY=your_qwen_api_key
# AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# === DeepSeek ===
# AI_API_KEY=your_deepseek_api_key
# AI_API_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# === OpenAI ===
# AI_API_KEY=your_openai_api_key
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo

# === Other OpenAI-compatible APIs ===
# AI_API_KEY=your_api_key
# AI_API_BASE_URL=https://your-api-endpoint/v1
# AI_MODEL=model_name
# NOTE: The endpoint domain must be in the AI_BASE_ALLOWLIST allowlist below,
# or it will be rejected by the security check.

# GitHub Token (optional, increases API rate limit)
# GITHUB_TOKEN=your_github_token

# === Security Hardening (all optional, sensible defaults) ===

# Verify TLS certificate for AI API requests. Default: true
# AI_VERIFY_SSL=true

# Allowlist of AI provider official base-url domains (comma-separated).
# Overrides the built-in 23-domain default entirely, so list every domain you use.
# Built-in default: api.deepseek.com,dashscope.aliyuncs.com,open.bigmodel.cn,api.moonshot.cn,
#   ark.cn-beijing.volces.com,api.siliconflow.cn,spark-api-open.xf-yun.com,qianfan.baidubce.com,
#   api.stepfun.com,api.lingyiwanwu.com,api.baichuan-ai.com,api.minimax.io,
#   api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.mistral.ai,
#   api.x.ai,api.groq.com,api.together.xyz,api.fireworks.ai,openrouter.ai,
#   api.perplexity.ai,api.cohere.com
# Example (add Tencent Hunyuan by overriding the whole list):
# AI_BASE_ALLOWLIST=api.deepseek.com,api.hunyuan.cloud.tencent.com

# Strict base-url check: must match allowlist and reject raw IP / intranet addresses. Default: true
# AI_STRICT_BASE=true