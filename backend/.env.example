# AI API Configuration
# Choose one AI provider and fill in the corresponding fields.

# === Alibaba Cloud Qwen (Recommended) ===
# AI_API_KEY=your_qwen_api_key
# AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# === DeepSeek ===
# AI_API_KEY=your_deepseek_api_key
# AI_API_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# === OpenAI ===
# AI_API_KEY=your_openai_api_key
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo

# === Other OpenAI-compatible APIs ===
# AI_API_KEY=your_api_key
# AI_API_BASE_URL=https://your-api-endpoint/v1
# AI_MODEL=model_name

# GitHub Token (optional, increases API rate limit)
# GITHUB_TOKEN=your_github_token